# scripts/train.py loads this project-local file before importing the training stack.
# Copy it to .shaft.env and point CUDA_HOME at the toolkit root containing bin/nvcc.
CUDA_HOME=/path/to/cuda-toolkit
# Use a node-local filesystem. Shaft derives <run-id>/rank-<local-rank> below this root.
SHAFT_TRITON_CACHE_ROOT=/local/path/to/shaft-triton-cache
