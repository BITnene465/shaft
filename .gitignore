# Shared policy: source, tests, configs, prompt pools, docs and lockfiles are visible
# by default. Machine-only exceptions belong in .git/info/exclude.
# Keep generated data under the root artifact directories below; do not ignore
# all YAML/JSON/images/model extensions (tests may maintain small fixtures).

# Credentials and local environment overrides; templates remain shareable.
.env
.env.*
!.env.example
!.env.*.example
!.env.template
.shaft.env
.shaft.env.*
!.shaft.env.example
!.shaft.env.*.example
!.shaft.env.template
/.codex-private/

# Python environments, downloaded runtimes and package/build output.
.venv/
venv/
/.uv-python/
/.cuda/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/

# Caches, test reports and notebook execution state.
/.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
/coverage.xml
/htmlcov/
/test-results/
.ipynb_checkpoints/
node_modules/
*.tsbuildinfo

# Training, inference, evaluation and downloaded datasets/models (root only).
/data/
/models/
/outputs/
/runs/
/wandb/
/eval_bench_store/

# Local operational snapshots, scratch work and archived experiments.
/.ops/
/.tmp/
/tmp/
/temp/
/subTasks/
/old/
/experimental/
/scripts/tmp/
/scripts/acc_exp/
/deployment/
/*-test/
/notes/
/notes.md
/NOTES.md
/docs/notes/
/docs/*_notes.md
/docs/notes*.md
/push_banana.sh
/AGENT_CODING.md
/CONTEXT.md

# Configs are maintained assets. Use these explicit names for local overrides;
# moving a config can change relative paths, so migrate references deliberately.
/configs/local/
/configs/**/*.local.yaml
/configs/**/*.local.yml
/configs/**/*.local.json

# Runtime logs and editor/OS state.
*.log
*.log.*
/logs/
/.vscode/
/.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
